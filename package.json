{
  "name": "wi2-free",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:gas": "tsc -p gas/tsconfig.json && cp gas/appsscript.json gas/build/appsscript.json && cp gas/.claspignore gas/build/.claspignore",
    "push:gas": "pnpm build:gas && clasp push",
    "build:macos": "zsh scripts/build-macos.zsh",
    "install:macos": "zsh scripts/install-macos.zsh",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:macos": "swift test --package-path macos/Wi2Agent"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260714.1",
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
